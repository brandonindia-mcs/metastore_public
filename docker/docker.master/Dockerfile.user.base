############ CONNECT ENTRYPOINT W/ VOLUME #############
RUN cat >/tmp/entrypoint.sh <<EOF
#!/bin/bash
set -euo pipefail
echo "Setting ownership of \${VOL_MNT} to \$(id -u):\$(id -g)"
sudo chown -R \$(id -u):\$(id -g) "\${VOL_MNT}"
if [ \$# -eq 0 ]; then
  exec bash
else
  exec "\$@"
fi
EOF
RUN sudo mv /tmp/entrypoint.sh /entrypoint.sh\
  && sudo chmod +x /entrypoint.sh
#######################################################

RUN sudo apt-get clean
RUN sudo rm -rf /var/lib/apt/lists/*
ARG BUILD_DATE
LABEL build-date=${BUILD_DATE}
RUN echo 'function rand { local n=${1:-8}; base64 </dev/urandom | tr -dc "A-Za-z0-9" | head -c $n; }\n\
echo -e "user:base ('${BUILD_DATE}')"\n\
'>>$USERHOME/.bashrc

RUN sudo apt-get update -qq\
  && sudo apt-get install -y locales

RUN sudo locale-gen en_US.UTF-8\
  && sudo update-locale LANG=en_US.UTF-8\
  && DEBIAN_FRONTEND=noninteractive TZ=UTC\
  sudo apt-get install -y --no-install-recommends\
    tzdata\
  && sudo ln -sf /usr/share/zoneinfo/Etc/UTC /etc/localtime\
  && sudo dpkg-reconfigure --frontend noninteractive tzdata


