RUN cat >>$USERHOME/.bashrc <<EOF
git config --global user.name "\$gitname"
git config --global user.email \$gituser
git config --global ssh.identity \$gitkey
git config --global core.autocrlf input
git config --global core.longpaths true
function printenv {   command printenv "\$@" | sort -t= -k1,1 | sed -E 's/^([^=]+)=/\x1b[0;33m\1\x1b[0m=/'; }
EOF

RUN cat >$USERHOME/bin/audit_env <<EOF
#!/bin/bash
unset AUDIT_FLAG
unset NON_COMPLIANT_FLAG

function run_audit {
local DIR=\${1:-./}
echo Searching in \$DIR
find \$DIR \
  -path "*/.git" -prune -o \
  -path "*/.vscode-server" -prune -o \
  -path "*/node_modules" -prune -o \
  -type f \( -name ".env*" -o -name "*.properties" \) -exec /bin/ls -l {} +
}
function find_env {
local DIR=\${1:-./}
find \$DIR \
  -path "*/.git" -prune -o \
  -path "*/.vscode-server" -prune -o \
  -path "*/node_modules" -prune -o \
  -type f \( -name ".env*" -o -name "*.properties" \) -print
}
function set_non_compliant {
local DIR=\${1:-./}
find "\$DIR" \
  -path "*/.git" -prune -o \
  -path "*/.vscode-server" -prune -o \
  -path "*/node_modules" -prune -o \
  -type f \( -name ".env*" -o -name "*.properties" \) \
  -exec sh -c '
    for f; do
      # Get current octal permissions
      # Try GNU stat first, then BSD
      perms=\$(stat -c "%a" "\$f" 2>/dev/null || stat -f "%Lp" "\$f")
      if [ "\$perms" != "400" ]; then
        chmod 400 "\$f"
        echo "Updated: \$f" && /bin/ls -Al \$f
      fi
    done
  ' sh {} +
}
function set_permission {
local DIR=\${1:-./}
find \$DIR \
  -path "*/.git" -prune -o \
  -path "*/.vscode-server" -prune -o \
  -path "*/node_modules" -prune -o \
  -type f \( -name ".env*" -o -name "*.properties" \) -exec chmod 400 {} +
}

for i in "\$@"
do
case \$i in
--help|-h)
  shift
  echo -e Usage: "\$(basename \$BASH_SOURCE) <OPTION> [DIR]
\t -h\t help
\t -l\t list all
\t -f\t find all
\t -x\t chmod 400 all
\t -X\t chmod 400 non compliant
  "
  exit 0
  ;;
-l)
  shift
  run_audit \$@;
  exit \$?
  ;;
-f)
  shift
  find_env \$@;
  exit \$?
  ;;
-x)
  shift
  AUDIT_FLAG=1
  set_permission \$@;
  exit \$?
  ;;
-X)
  shift
  NON_COMPLIANT_FLAG=1
  set_non_compliant \$@;
  exit \$?
  ;;
esac
done

# No args, call for help
. \$BASH_SOURCE -h

EOF
RUN sudo chmod u+x $USERHOME/bin/audit_env
