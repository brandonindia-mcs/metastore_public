FROM user:base-d
ARG THISUSER
ARG HOMEDIR=/home
ARG USERHOME=$HOMEDIR/$THISUSER

# -- Source - https://stackoverflow.com/a/57739187
# -- Posted by Tarique, modified by community. See post 'Timeline' for change history
# -- Retrieved 2026-04-11, License - CC BY-SA 4.0
RUN wget --quiet -O - https://www.postgresql.org/media/keys/ACCC4CF8.asc | sudo apt-key add -\
  && sudo sh -c 'echo "deb http://apt.postgresql.org/pub/repos/apt/ `lsb_release -cs`-pgdg main" >> /etc/apt/sources.list.d/pgdg.list'\
  && sudo apt-get update\
  && sudo apt-get install -y\
     postgresql-client-17

RUN sudo apt-get install -y\
    inetutils-tools\
    dnsutils\
    traceroute\
    bind9-host\
    locales\
    zip\
    bsdmainutils\
    ntpdate\
    tree\
    binutils   
    
RUN sudo apt-get clean
RUN sudo rm -rf /var/lib/apt/lists/*
# FROM base AS end
COPY assets.docker/git-prompt.sh $USERHOME/git-prompt.sh
# vimrc colo values: slate | pablo | murphy
RUN cat >~/.vimrc <<EOF
set tabstop=8 softtabstop=0 expandtab shiftwidth=4 smarttab autoindent
set number
set nocompatible
syntax on
colo pablo
set cursorline
set hls
hi CursorLine   cterm=NONE ctermbg=NONE ctermfg=NONE
hi CursorLineNr   cterm=NONE ctermbg=36 ctermfg=NONE
EOF
RUN cat >>$USERHOME/.bashrc <<EOF
. ~/git-prompt.sh
function set_ps1 {
PS1_ON="\[\033[0m\]on"
PS1_COLON="\[\033[0m\]:"
PS1_HOST="\[\033[0;34m\]\h"
PS1_BRACKET_o="\[\033[0;35m\]["
PS1_BRACKET_c="\[\033[0;35m\]]"
PS1_at="\[\033[0m\]@\[\033[0m\]"

# PS1_DATE="\[\033[1;34m\]\\\`date +%Y-%m-%d\\\`\[\033[0m\]"
# PS1_TIME="\[\033[3;34m\]\\\`date +%H:%M:%S\\\`\[\033[0m\]"
# PS1_DATETIME="\${PS1_DATE} \${PS1_TIME}"
PS1_DATETIME="\[\033[0;31m\]\\\`date +%Y-%m-%d\\\` \[\033[1;31m\]\\\`date +%H:%M:%S\\\`"
PS1_GITSSH="\[\033[0;36m\]\\\`basename \\\$(git config --get-regexp "ssh.identity"|tail -1|awk '{ print \\\$2 }') 2>/dev/null\\\`"
PS1_GITUSER="\[\033[0;36m\]\\\`git config --get-regexp \"user.email\"|tail -1|sed \"s/user\.email//\"\\\`"
PS1_BRANCH="\[\033[0;35m\](\\\$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo not-a-repo))"
PS1_OS="\[\033[3;34m\]\$(grep -iE ^ID= /etc/os-release 2>/dev/null|awk -F= '{print \$2}'|awk '{print \$1}')"
PS1_USER="\[\033[1;34m\]\u\[\033[0m\]"
PS1_HOST="\[\033[3;34m\]\h\[\033[0m\]"
PS1_PWD="\[\033[0;34m\]\w\[\033[0m\]"

PS1_REPO="check-ps1-repo-in-dot-bashrc"
PS1_REPO="\[\033[1;35m\]\\\`git remote -v|head -1 2>/dev/null|awk '{print \\\$2}'\\\`"

PS1_GITLINE="\${PS1_GITSSH}\${PS1_COLON} \${PS1_REPO}"
PS1_USERATHOST="\${PS1_HOST} (\${PS1_USER}) \${PS1_BRANCH}"
PS1_ENV="\[\033[3;32m\]\\\`echo \\\$sdenv\\\`"
PS1_RM="\[\033[0;31m\]\${__RM__}"
ps1=
ps1+="\n\${PS1_USERATHOST}"
ps1+="\n\${PS1_GITLINE}"
ps1+="\n\${PS1_DATETIME} \${PS1_ENV}\[\033[0;32m\]\\\${VIRTUAL_ENV_PROMPT}\${PS1_BRACKET_o}\${PS1_PWD}\${PS1_BRACKET_c}"
ps1+="\n\${PS1_RM} \[\033[1;33m\]\W/\[\033[0;32m\]$ \[\033[0m\]"
echo \$ps1
}
function fix_ps1 {
echo "\n\[\033[3;34m\]\h\[\033[0m\] (\[\033[1;34m\]\u\[\033[0m\]) \[\033[0;35m\](fixps1)\n\[\033[0;31m\]\\\`date +%Y-%m-%d\\\` \[\033[1;31m\]\\\`date +%H:%M:%S\\\` \[\033[3;32m\]\\\`echo \\\$sdenv\\\`\[\033[0;32m\]\\\${VIRTUAL_ENV_PROMPT}\[\033[0;35m\][\[\033[0;34m\]\w\[\033[0m\]\[\033[0;35m\]]\n\[\033[0;31m\]\${__RM__} \[\033[1;33m\]\W/\[\033[0;32m\]\\\$ \[\033[0m\]"
}
function fixps1 { export PS1="\$(fix_ps1)"; }
function reset_ps1 { export PS1="\$(set_ps1)"; }
function resetps1 { export PS1="\$(set_ps1)"; }
function awswho { aws sts get-caller-identity; }
alias docker="sudo docker"
alias ls="ls -AlFtr --color=auto --group-directories-first"
. $USERHOME/appdev/bashrc-hook.sh
export PS1="\$(set_ps1)"
EOF

# RUN cat >~/.sqliterc <<EOF
# .headers on
# .mode column
# .nullvalue NULL
# EOF

ARG BUILD_DATE
LABEL build-date=${BUILD_DATE}
RUN echo 'function rand { local n=${1:-8}; base64 </dev/urandom | tr -dc "A-Za-z0-9" | head -c $n; }\n\
echo -e "user:base ('${BUILD_DATE}')"\n\
'>>$USERHOME/.bashrc


